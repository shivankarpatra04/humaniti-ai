{
	servers {
		# a 1 GB upload over a slow uplink takes many minutes; no write timeout so long video streams are not cut
		timeouts {
			read_header 30s
			read_body 30m
			idle 10m
		}
	}
}

{$DOMAIN} {
	# Streamlit and the API both cap uploads at 1024 MiB; leave room for the multipart overhead
	request_body {
		max_size 1100MiB
	}

	# PUBLIC_API_URL is https://$DOMAIN/api; the prefix is stripped, so the API keeps its own paths.
	# Every route except /health and the signed video link still needs the X-API-Key header.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle {
		reverse_proxy frontend:8501
	}
}
