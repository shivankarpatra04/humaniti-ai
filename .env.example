# Supabase > Connect > Session pooler (port 5432). Keep the +psycopg driver prefix.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Docker Compose publishes its Redis here; the compose services use redis://redis:6379/0 instead
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=sk-ant-...
# any long random string; the frontend sends it as X-API-Key: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
# where reviewers' browsers reach the API; the report's player streams the recording from it
PUBLIC_API_URL=http://localhost:8000
LLM_MODEL=claude-haiku-5-5
WHISPER_MODEL=small.en
# production only (docker-compose.prod.yml): Caddy gets an HTTPS certificate for this name, e.g. 34-93-10-20.sslip.io
DOMAIN=
# the password reviewers type before the frontend shows anything
DEMO_PASSWORD=
